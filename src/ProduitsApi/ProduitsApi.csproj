<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    API de démonstration pour la formation "Postman et API REST".
    VERSION DE SECOURS .NET 8 (branche net8). La version de référence est en .NET 10 (branche main).
    Projet ASP.NET Core .NET 8, sans base de données (stockage en mémoire).
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ProduitsApi</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Validation des jetons JWT envoyés dans le header "Authorization: Bearer <token>" -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.33" />
  </ItemGroup>

</Project>
